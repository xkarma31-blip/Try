{
  "name": "witches-io",
  "version": "1.0.0",
  "private": true,
  "description": "Blobz.io — a tiny browser .io game with local-network (LAN) multiplayer. No build step, no internet required.",
  "type": "module",
  "scripts": {
    "test": "node test/smoke.mjs && node test/joystick.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:joystick": "node test/joystick.mjs",
    "start": "python3 -m http.server 8000",
    "server": "node server/index.js"
  },
  "dependencies": {
    "bonjour": "^3.5.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0"
  }
}
